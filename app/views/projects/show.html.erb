<% content_for :title, "#{@project.title} · Lyricfy" %>
<div class="breadcrumbs text-sm"><ul><li><%= link_to "Projetos", root_path %></li><li><%= @project.title %></li></ul></div>
<header class="studio-heading"><div><h1><%= @project.title %></h1><p class="muted metadata"><%= @project.media_kind == "video" ? "Vídeo" : "Áudio" %><span>·</span><%= @project.duration.round(1) %> s<span>·</span><%= @project.original_filename %></p></div><div class="heading-actions"><button class="btn btn-outline" type="submit" form="subtitle-form"><%= icon("device-floppy") %> Salvar legenda</button><a class="btn btn-primary" href="#export-settings"><%= icon("upload") %> Exportar vídeo</a></div></header>
<% if @project.errors.any? %><div class="alert alert-error" role="alert"><ul><% @project.errors.full_messages.each do |message| %><li><%= message %></li><% end %></ul></div><% end %>
<div id="lyric-editor" data-duration="<%= @project.duration %>">
<div class="editing-workspace">
<section class="preview-column" aria-label="Prévia da mídia">
<div class="media-stage" data-subtitle-position="<%= @project.subtitle_position %>">
<% if @project.media_kind == "video" %><div id="video-caption" class="video-caption" aria-live="off"></div><video id="media-preview" controls preload="auto" src="<%= media_project_path(@project) %>"><track kind="subtitles" src="<%= subtitles_project_path(@project, format: :vtt) %>" srclang="pt" label="Letra" default></video>
<% else %><div class="audio-display"><%= icon("music") %><span id="audio-caption">Sua letra ganha voz.</span></div><audio id="media-preview" controls preload="metadata" src="<%= media_project_path(@project) %>"></audio><% end %>
</div>
<div class="preview-tools"><div class="field"><label for="seek-time">Ir para (segundos)</label><div class="join"><input id="seek-time" class="input join-item" type="number" min="0" max="<%= @project.duration %>" step="0.1" value="0"><button id="seek-button" type="button" class="btn join-item" aria-label="Ir para tempo"><%= icon("player-track-next") %></button></div></div><div class="field"><label>Ajustar linha selecionada</label><div class="join"><button type="button" id="shift-back" class="btn join-item">− 0,5 s</button><button type="button" id="shift-forward" class="btn join-item">+ 0,5 s</button></div></div></div>
<p class="muted small">A prévia acompanha sua edição. Salve a legenda antes de exportar.</p><p id="editor-message" class="editor-message small" role="status"></p>
</section>
<section class="lyrics-column" aria-label="Editor de legendas">
<div class="editor-toolbar"><div role="tablist" aria-label="Modo do editor" class="tabs tabs-border"><button type="button" role="tab" id="lines-tab" class="tab tab-active" aria-selected="true" aria-controls="lines-panel">Legendas</button><button type="button" role="tab" id="srt-tab" class="tab" aria-selected="false" aria-controls="srt-panel">SRT</button></div><label class="btn btn-ghost btn-sm import-srt-label" for="srt-import"><%= icon("upload") %> Importar SRT<input id="srt-import" type="file" accept=".srt,text/plain"></label></div>
<%= form_with model: @project, local: true, id: "subtitle-form" do |form| %>
<div class="field subtitle-position-field"><%= form.label :subtitle_position, "Posição da legenda" %><%= form.select :subtitle_position, [["Superior", "top"], ["Centro", "center"], ["Inferior", "bottom"]], {}, class: "select" %><p class="muted small">Vale para todas as linhas. Salve para aplicar à exportação.</p></div>
<div class="subtitle-typography">
<div class="field"><%= form.label :subtitle_font, "Fonte da legenda" %><%= form.select :subtitle_font, [["Serifada · Liberation Serif", "Liberation Serif"], ["Sem serifa · Liberation Sans", "Liberation Sans"], ["Monoespaçada · Liberation Mono", "Liberation Mono"]], {}, class: "select" %></div>
<div class="field"><%= form.label :subtitle_size, "Tamanho da letra" %><%= form.number_field :subtitle_size, min: 12, max: 48, step: 1, required: true, class: "input" %></div>
</div><p class="muted small">De 12 a 48, proporcional à altura do vídeo. Vale para todas as linhas.</p>
<div id="lines-panel" role="tabpanel" aria-labelledby="lines-tab"><div class="cue-table-scroll"><table class="table cue-table"><thead><tr><th><span class="sr-only">Linha</span></th><th>Início</th><th>Fim</th><th>Texto</th><th><span class="sr-only">Remover</span></th></tr></thead><tbody id="cue-rows"></tbody></table></div><button id="add-cue" type="button" class="btn btn-outline add-cue"><%= icon("plus") %> Adicionar legenda</button></div>
<div id="srt-panel" role="tabpanel" aria-labelledby="srt-tab" hidden><%= form.label :subtitle_text, "Texto SRT" %><%= form.text_area :subtitle_text, class: "textarea srt-source", rows: 15, spellcheck: false, placeholder: "1\n00:00:00,000 --> 00:00:03,000\nSua primeira legenda" %><p class="muted small">Formato UTF-8. Separe os blocos por uma linha em branco. A numeração é corrigida automaticamente ao sair do campo ou salvar; texto e tempos são preservados.</p></div>
<div class="editor-footer"><span id="subtitle-save-status" class="muted small" role="status">Todas as alterações salvas.</span><%= link_to "Baixar SRT", subtitles_project_path(@project, format: :srt), class: "link small" %></div>
<noscript><p>Ative JavaScript para editar linhas. Você pode editar o SRT diretamente abaixo.</p><style>#srt-panel[hidden]{display:block}#lines-panel{display:none}</style></noscript>
<% end %></section>
</div>
<section id="export-settings" class="export-settings" aria-label="Configurações de exportação"><%= form_with url: project_exports_path(@project), scope: :export, local: true, id: "export-form" do |form| %>
<div class="field"><%= form.label :aspect, "Formato de saída" %><%= form.select :aspect, [["Original · MP4", "original"], ["Vertical · 9:16", "vertical"], ["Quadrado · 1:1", "square"]], {}, class: "select" %></div>
<div class="field"><%= form.label :start_seconds, "Início (segundos)" %><%= form.number_field :start_seconds, class: "input", min: 0, step: 0.001, placeholder: "0" %></div>
<div class="field"><%= form.label :end_seconds, "Fim (segundos)" %><%= form.number_field :end_seconds, class: "input", min: 0, step: 0.001, max: @project.duration, placeholder: @project.duration.round(3).to_s %></div>
<div class="export-caption"><strong>Legendas incorporadas</strong><span class="muted small">Tempos vazios exportam a mídia inteira.</span></div><button type="submit" class="btn btn-primary"><%= icon("upload") %> Exportar vídeo</button>
<% end %><p class="muted small">Vertical e quadrado preservam a imagem com barras. Áudio recebe um fundo escuro.</p></section>
</div>
<section class="export-history"><div class="section-heading"><h2>Exportações</h2><%= link_to project_path(@project), class: "btn btn-ghost btn-sm" do %><%= icon("refresh") %> Atualizar<% end %></div>
<% if @exports.empty? %><p class="muted">Seu primeiro vídeo aparecerá aqui. A geração acontece em segundo plano.</p><% else %><div class="export-list"><% @exports.each do |export| %><article class="export-row"><div><strong><%= { "original" => "Original", "vertical" => "Vertical", "square" => "Quadrado" }[export.aspect] %></strong><small class="muted"><%= export.start_seconds %> s – <%= export.end_seconds %> s · <%= export.created_at.strftime("%d/%m %H:%M") %></small></div><span class="badge <%= export.status == "completed" ? "badge-success" : "badge-ghost" %>"><%= {"queued"=>"Na fila", "running"=>"Gerando", "completed"=>"Pronto", "failed"=>"Falhou"}[export.status] %></span><% if export.status == "completed" %><%= link_to download_project_export_path(@project, export), class: "btn btn-outline btn-sm" do %><%= icon("download") %> Baixar vídeo<% end %><% end %><% if export.status == "failed" %><p class="export-error"><%= export.error_message %></p><% end %></article><% end %></div><% end %></section>
